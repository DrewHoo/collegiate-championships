{
  // The share worker: per-address <head> rewrites and og cards in front of
  // GitHub Pages. Deploy with: npm run worker:deploy (deploy.yml does it after
  // every push to main, with the CLOUDFLARE_API_TOKEN repo secret).
  "name": "collegiate-championships-share",
  "main": "index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  // the trailing wildcard matters: a bare pattern never matches a query string
  "routes": [{ "pattern": "drewhoover.com/collegiate-championships/*", "zone_name": "drewhoover.com" }],
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // the card's fonts ride in the bundle
  "rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }]
}
