{
  "name": "collegiate-championships",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --port 4174 --strictPort",
    "deploy": "gh-pages -d dist",
    "gen:og": "node scripts/gen-og.mjs",
    "worker:dev": "npx wrangler dev -c workers/share/wrangler.jsonc --local --port 8788 --var ORIGIN:http://localhost:4174 --var NO_REPORT:1",
    "worker:deploy": "npx wrangler deploy -c workers/share/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@vitejs/plugin-react": "^4.2.1",
    "cheerio": "^1.2.0",
    "gh-pages": "^6.1.1",
    "opentype.js": "^1.3.4",
    "sharp": "^0.34.5",
    "vite": "^5.1.0",
    "workers-og": "^0.0.27",
    "wrangler": "^4.151.3"
  }
}
